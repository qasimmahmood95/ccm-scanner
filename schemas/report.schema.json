{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qasimmahmood95/ccm-scanner/main/schemas/report.schema.json",
  "title": "ccm-scanner report",
  "description": "Machine-readable CCM compliance report. This document is the evidence pack: run metadata, per-domain roll-ups, and every verdict with the evidence it was derived from.",
  "type": "object",
  "required": [
    "schemaVersion",
    "metadata",
    "headline",
    "controls",
    "findings",
    "domains",
    "verdicts"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "description": "Pinned to the version this schema describes; kept in step with REPORT_SCHEMA_VERSION.",
      "const": "1.0.0"
    },
    "metadata": { "$ref": "#/$defs/metadata" },
    "headline": {
      "description": "fail when any control failed; drives the CLI exit code.",
      "enum": ["pass", "fail"]
    },
    "controls": {
      "description": "Distinct CCM controls assessed, by rolled-up status.",
      "$ref": "#/$defs/counts"
    },
    "findings": {
      "description": "Individual verdicts, typically one per resource examined.",
      "$ref": "#/$defs/counts"
    },
    "domains": {
      "type": "array",
      "items": { "$ref": "#/$defs/domainRollup" }
    },
    "verdicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/verdict" }
    }
  },
  "$defs": {
    "domain": {
      "description": "CCM domains in scope for v1.",
      "enum": ["IAM", "LOG", "CEK", "IVS"]
    },
    "counts": {
      "type": "object",
      "required": ["pass", "fail", "notApplicable", "total"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "notApplicable": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "domainRollup": {
      "type": "object",
      "required": ["domain", "controls", "findings"],
      "additionalProperties": false,
      "properties": {
        "domain": { "$ref": "#/$defs/domain" },
        "controls": { "$ref": "#/$defs/counts" },
        "findings": { "$ref": "#/$defs/counts" }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["tool", "ccmVersion", "input", "generatedAt"],
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        },
        "ccmVersion": {
          "description": "Pinned CCM release, e.g. v4.0.13 (ADR-0003).",
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object",
          "required": ["source", "digest"],
          "additionalProperties": false,
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "digest": {
              "description": "sha256 (lowercase hex) of the input.",
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "generatedAt": {
          "description": "ISO-8601 timestamp, injected by the caller so reports are reproducible.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["resourceAddress", "observed"],
      "additionalProperties": false,
      "properties": {
        "resourceAddress": { "type": "string", "minLength": 1 },
        "attribute": { "type": "string" },
        "observed": { "description": "What was actually seen. Any JSON value." },
        "expected": { "type": "string" }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["ccmId", "ccmTitle", "checkId", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "ccmId": {
          "description": "Must have a row in docs/control-mapping.md.",
          "type": "string",
          "pattern": "^(IAM|LOG|CEK|IVS)-[0-9]{2}$"
        },
        "ccmTitle": { "type": "string", "minLength": 1 },
        "checkId": {
          "description": "Stable <domain>/<slug>. Must not embed the CCM control number (ADR-0003).",
          "type": "string",
          "pattern": "^(iam|log|cek|ivs)/[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "status": { "enum": ["pass", "fail", "not_applicable"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "description": "A not_applicable verdict must carry a reason.",
          "if": {
            "properties": { "status": { "const": "not_applicable" } },
            "required": ["status"]
          },
          "then": { "required": ["reason"] }
        },
        {
          "description": "A pass or fail verdict must carry evidence.",
          "if": {
            "properties": { "status": { "enum": ["pass", "fail"] } },
            "required": ["status"]
          },
          "then": { "properties": { "evidence": { "type": "array", "minItems": 1 } } }
        }
      ]
    }
  }
}
